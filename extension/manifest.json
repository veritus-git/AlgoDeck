{
  "manifest_version": 3,
  "name": "AlgoDeck ⚡ Koło MAP",
  "version": "2.0.0",
  "key": "",
  "description": "Zautomatyzowane środowisko do algorytmiki i programowania dla Koła MAP, OIJ, OI oraz Szkopuła",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AlgoDeck ⚡ Koło MAP",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "downloads",
    "notifications",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ]
}
