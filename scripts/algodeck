#!/usr/bin/env bash
# ==============================================================================
# AlgoDeck ⚡ Koło MAP - Główny CLI & Launcher (100% Rust Architecture)
# ==============================================================================

set -e

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

find_bin() {
    if [ -x "$HOME/.local/bin/algodeck" ]; then
        echo "$HOME/.local/bin/algodeck"
    elif [ -x "$REPO_DIR/target/release/algodeck" ]; then
        echo "$REPO_DIR/target/release/algodeck"
    elif [ -x "$REPO_DIR/target/debug/algodeck" ]; then
        echo "$REPO_DIR/target/debug/algodeck"
    elif command -v algodeck >/dev/null 2>&1; then
        command -v algodeck
    else
        echo ""
    fi
}

BIN="$(find_bin)"

if [ -z "$BIN" ]; then
    echo "⚡ Kompilacja AlgoDeck w Rust..."
    (cd "$REPO_DIR" && cargo build --release)
    BIN="$REPO_DIR/target/release/algodeck"
fi

exec "$BIN" "$@"
