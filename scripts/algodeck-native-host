#!/usr/bin/env python3
"""
AlgoDeck Native Messaging Host
Umożliwia rozszerzeniu przeglądarki bezpośrednie uruchamianie i zatrzymywanie
środowiska AlgoDeck (nawet gdy daemon jest offline).
"""
import sys, json, struct, subprocess, os

def get_message():
    raw_length = sys.stdin.buffer.read(4)
    if len(raw_length) == 0:
        sys.exit(0)
    msg_length = struct.unpack('@I', raw_length)[0]
    message = sys.stdin.buffer.read(msg_length).decode('utf-8')
    return json.loads(message)

def send_message(message_content):
    encoded = json.dumps(message_content).encode('utf-8')
    sys.stdout.buffer.write(struct.pack('@I', len(encoded)))
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.flush()

if __name__ == '__main__':
    try:
        msg = get_message()
        action = msg.get("action", "start")
        if action == "start":
            env = dict(os.environ)
            if "DISPLAY" not in env or not env["DISPLAY"]:
                env["DISPLAY"] = ":0"
            bin_path = os.path.expanduser("~/.local/bin/algodeck")
            if not os.path.isfile(bin_path):
                repo_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "algodeck")
                if os.path.isfile(repo_bin):
                    bin_path = repo_bin

            subprocess.Popen([bin_path, "start"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            send_message({"success": True, "status": "starting"})
        elif action == "stop":
            bin_path = os.path.expanduser("~/.local/bin/algodeck")
            if not os.path.isfile(bin_path):
                repo_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "algodeck")
                if os.path.isfile(repo_bin):
                    bin_path = repo_bin

            subprocess.Popen([bin_path, "stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            send_message({"success": True, "status": "stopping"})
        elif action == "gui":
            env = dict(os.environ)
            if "DISPLAY" not in env or not env["DISPLAY"]:
                env["DISPLAY"] = ":0"
            bin_path = os.path.expanduser("~/.local/bin/algodeck")
            if os.path.isfile(bin_path):
                subprocess.Popen([bin_path, "gui"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            else:
                panel_sh = os.path.expanduser("~/.local/bin/sd_algo_panel.sh")
                if os.path.isfile(panel_sh):
                    subprocess.Popen([panel_sh], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            send_message({"success": True, "status": "gui_launched"})
        elif action == "open_vscode":
            pid = msg.get("problem_id", "")
            sd_code_sh = os.path.expanduser("~/.local/bin/sd_algo_code.sh")
            env = dict(os.environ)
            if "DISPLAY" not in env or not env["DISPLAY"]:
                env["DISPLAY"] = ":0"
            if pid:
                pdir = os.path.expanduser(f"~/algodeck-workspace/{pid}")
                pcpp = os.path.join(pdir, f"{pid}.cpp")
                subprocess.Popen(["bash", sd_code_sh, pdir, pcpp], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            else:
                subprocess.Popen(["bash", sd_code_sh], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            send_message({"success": True, "status": "vscode_launched"})
        else:
            send_message({"success": False, "error": "unknown action"})
    except Exception as e:
        send_message({"success": False, "error": str(e)})
